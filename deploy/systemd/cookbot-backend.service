[Unit]
Description=CookBot backend
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=/opt/cookbot
Environment=COOKBOT_MODE=simulator
Environment=COOKBOT_MEGA_TRANSPORT=fake
Environment=COOKBOT_CAMERA=mock
Environment=COOKBOT_AI=mock
Environment=COOKBOT_BIND=127.0.0.1
Environment=COOKBOT_PORT=8000
EnvironmentFile=-/etc/cookbot/cookbot.env
ExecStart=/usr/bin/python3 -m uvicorn unoq_backend.app:app --host ${COOKBOT_BIND} --port ${COOKBOT_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
